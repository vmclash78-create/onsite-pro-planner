# Copy to .env for local development. Never commit .env files.
# VITE_* values are public and are embedded in browser bundles; never put secrets in them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required only if the protected cleanup scheduler is configured.
LOVABLE_CRON_SECRET=
# Optional rotation window; keep different from LOVABLE_CRON_SECRET.
LOVABLE_CRON_SECRET_PREVIOUS=
